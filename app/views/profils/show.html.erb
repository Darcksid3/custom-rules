<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 rounded-4 bg-white m-2 shadow-sm">
            <h2 class="h2-sign">Profil</h2>
            <p class="mb-1"><strong>Username :</strong> <%= @user.username %> </p>
            <p class="mb-0"><strong>Email :</strong> <%= @user.email %></p>
            <%= link_to "🙂 Mon compte", edit_user_registration_path, class: "bouton-sign mt-3" %>

        </div>
        <div class="col rounded-4 bg-white m-2 shadow-sm">
            <h3 class="h2-sign">Mes conversations</h3>
            <ol>
                <% @user.conversations.each do |conversation| %>
                <li><%= link_to conversation.title, conversation_path(conversation), class:"link-card-profile" %></li>
                <% end %>
            </ol>

        </div>
    </div>
</div>
