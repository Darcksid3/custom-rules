<%= render "shared/flashes_ok" %>

<div class="container py-4">

  <div class="text-center mb-2">
    <%= image_tag "logo.png",
      class: "logo img-fluid",
      alt: "Logo application" %>
  </div>

  <h3 class="mt-2 mb-4 text-center">
    La seule application <strong>gratuite</strong> qui vous génère des
    <em>funny rules</em> de vos jeux préférés !
  </h3>

  <div class="row g-4">
    <% @games.each do |game| %>
      <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
        <%= render "shared/card", game: game %>
      </div>
    <% end %>
  </div>

</div>


