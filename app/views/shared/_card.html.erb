<div class="card game-card" style="width: 18rem;">
<% case game.name %>
<% when "Monopoly" %>
<%= image_tag("https://cdn.cultura.com/cdn-cgi/image/width=1280/media/pim/23_244147_1_10_FR.jpg", width: "45%", class:"img-game pt-2") %>
<% when "Skyjo" %>
<%= image_tag("https://b4049544.smushcdn.com/4049544/wp-content/uploads/2025/03/35084-d19-Skyjo.jpg?lossy=2&strip=1&webp=1", width: "45%", class:"img-game pt-2") %>
<% when "Br-Uno" %>
<%= image_tag("https://www.pixiegames.fr/989-product_zoom/uno.jpg", width: "45%", class:"img-game pt-2") %>
<% when "Scrabble" %>
<%= image_tag("https://cdn.cultura.com/cdn-cgi/image/width=1280/media/pim/77_241905_1_10_FR.jpg", width: "45%", class:"img-game pt-2") %>
  <!-- <img src="..." class="card-img-top" alt="..."> -->
  <% end %>
  <div class="card-body">
    <h5 class="card-title fw-semibold text-uppercase"> <%= game.name %></h5>
    <p class="card-text">Nombre de joueurs :  <%= game.nb_players %></p>
    <%= link_to "Funny rules ? 🎭", conversations_path, data: { turbo_method: :post }, class:"bouton-card link-underline link-underline-opacity-0" %>
  <svg class="card-meeple-watermark" viewBox="0 0 100 100"><path d="M50,15 C58,15 65,22 65,30 C65,38 58,45 50,45 C42,45 35,38 35,30 C35,22 42,15 50,15 Z M50,48 C65,48 82,53 88,65 C92,72 80,75 75,73 L82,100 L65,100 L50,85 L35,100 L18,100 L25,73 C20,75 8,72 12,65 C18,53 35,48 50,48 Z"/></svg>
  </div>
</div>
