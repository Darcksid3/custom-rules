

<div class="card game-card h-100">

  <h5 class="card-title w-100 text-center pt-1"><%= c.game.name %></h5>
  <div class="card-body">
      <h5 class="card-name fw-semibold text-uppercase text-center">
        <%= c.name %>
        </h5>
      <div class="content-cr">
        <%= c.content.split.first(14).join(' ') %>...
      </div>
  </div>
</div>
