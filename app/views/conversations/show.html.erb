<%= turbo_stream_from @conversation %>

<h1>Conversations#show</h1>
<%= link_to "← #{@conversation.game.name}", game_path(@conversation.game) %>

<h1 id="titre"><%= @conversation.title %></h1>

<div id="messages">
  <%= render @conversation.messages, messages: @conversation.messages %>
</div>

<div id="new_message_container" data-controller="stopbutton">
  <%= render "messages/form", conversation: @conversation, message: @message %>
</div>
