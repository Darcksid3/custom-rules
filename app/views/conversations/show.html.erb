<h1 class="h2-sign mt-2">Crée tes funny rules !</h1>

  <h3 id="titre" class="mt-2 ms-3"><%= @conversation.title %></h3>

  <div id="messages">
    <%= render "messages/messages", messages: @conversation.messages %>
  </div>

  <div id="new_message_container" data-controller="stopbutton">
    <%= render "messages/form", conversation: @conversation, message: @message %>
    <%#= simple_form_for [@conversation, @message] do |f| %>
      <%#= f.input :content, label: "Ask a question", required: true, placeholder: "crée un nouvelle règle?" , input_html: { class:"input_ask", data: {action: "keyup->stopbutton#call", stopbutton_target: "input"}} %>
      <%#= f.button :submit, 'Demander au bot', class: 'bouton-sign disabled', data: { stopbutton_target: "button" } %>
    <%# end %>
  </div>
  <%= link_to "← Go back to #{@conversation.game.name}", game_path(@conversation.game), class: "bouton-sign mt-5" %>
</div>
