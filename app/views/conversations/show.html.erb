<h1>Conversations#show</h1>
<p>Find me in app/views/conversations/show.html.erb</p>

<% @conversation.messages.each do |message| %>
    <p><%= message.content %></p>
<% end %>

<div>
    <%#= render "messages/new" %>
</div>
<div class="choice_games w-75 mx-auto">
<%= simple_form_for [@conversation, @message] do |f| %>
    <% @games.each do |game| %>
      <%= f.submit game.name, class:'btn btn-primary' %>
    <% end %>
    <%= f.input :content, label: "Game name", required: true, placeholder:"Game name" %>
    <%= f.button :submit, 'Ask LLM', class: 'btn btn-primary' %>
  <% end %>
<%= link_to "back", root_path %>
</div>


