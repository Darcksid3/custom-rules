<h1>Conversations#show</h1>
<%= link_to "← #{@conversation.game.name}", game_path(@conversation.game) %>

<div id="messages">
  <% @conversation.messages.each do |message| %>
    <% if message.role == "user" %>
      <div class="d-flex justify-content-end mb-2">
        <div class="bg-white px-3 pb-0 pt-3 rounded-pill">
          <%= raw(render_markdown(message.content)) %>
        </div>
      </div>
    <% elsif message.role == "assistant" %>
      <div class="d-flex justify-content-start mb-5">
        <div class="px-3 pb-0 pt-3">
          <%= raw(render_markdown(message.content)) %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<div id="new_message_container">
  <%= simple_form_for [@conversation, @message] do |f| %>
    <%= f.input :content, label: "Ask a question", required: true, placeholder: "crée un nouvelle règle?" %>
    <%= f.button :submit, 'Demander au bot', class: 'btn btn-primary' %>
  <% end %>
</div>
