<!-- path: <p>Find me in app/views/games/show.html.erb</p> -->
<div class="container my-5">
  <div class="row g-4">
    <div class="col-12 col-lg-7">
      <div class="card game-show-card">
        <div class="card-body">
          <h1 class="h2-sign"><%= @game.name %></h1>
          <p>Nombre de joueurs: <%= @game.nb_players %></p>

          <p>Créez tes règles personnalisé grace à notre agent 🤖 </p>


          <%= link_to "New chat", game_conversations_path(@game), data: {turbo_method: :post}, class: "bouton-sign border-0" %>

        </div>
      </div>

      <div class="card game-show-card game-show-real-rules mt-4">

        <div class="card-body">
          <%= link_to "← Retour aux jeux", root_path, class: "bouton-sign" %>
          <h2 class="mt-4 h2-sign"> Real game rules</h2>

          <% if @game.real_rules.present? %>
            <%# Les règles viennent de la colonne real_rules dans la table games. %>
            <%= raw(render_markdown(@game.real_rules)) %>
          <% else %>
            <p>Les règles de ce jeu ne sont pas encore disponibles.</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-5">
      <div class="card game-show-card game-show-custom-rules h-100">
        <div class="card-body">
          <h2 class="h2-sign">Custom rules</h2>

          <% if @custom_rules.any? %>
          <ol>
              <% @custom_rules.each do |custom_rule| %>
                  <li><%= link_to custom_rule.name, game_custom_rule_path(@game, custom_rule), class:"link-card" %></li>
              <% end %>
          </ol>
          <% else %>
            <p>Vous n'avez pas encore créé de règles personnalisées pour ce jeu.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
